<?xml version="1.0"?>
<!--
  Kinematic extract of https://github.com/agilexrobotics/agx_arm_urdf
  commit 680fa925cd00db7e2628563d2edc5540963045de (MIT).
  Visual meshes, collision, and inertia are omitted; forward kinematics does not use them.
  tcp_joint is not in that repository. It is the fixed tool point, in the link6 frame,
  that makes this chain match recorded Piper X poses. Finger link origins are at z=0.1425
  and do not match the recording.
-->
<robot name="piper_x">

  <link name="world"/>
  <link name="base_link"/>
  <link name="link1"/>
  <link name="link2"/>
  <link name="link3"/>
  <link name="link4"/>
  <link name="link5"/>
  <link name="link6"/>
  <link name="flange_link"/>
  <link name="gripper_base"/>
  <link name="gripper_link"/>
  <link name="gripper_link1"/>
  <link name="gripper_link2"/>
  <link name="tcp_link"/>
  <joint name="world_to_base_link" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.123" rpy="0 0 3.1415926"/>
    <parent link="base_link"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.6179938" upper="2.6179938"/>
  </joint>
  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="-1.5707963 -3.005806 -3.1415926"/>
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="3.1415926"/>
  </joint>
  <joint name="joint3" type="revolute">
    <origin xyz="0.28503 0 0" rpy="0 0 2.8380798"/>
    <parent link="link2"/>
    <child link="link3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9670597" upper="0"/>
  </joint>
  <joint name="joint4" type="revolute">
    <origin xyz="0.27364 0 0" rpy="0 0 0.0806342"/>
    <parent link="link3"/>
    <child link="link4"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.553343" upper="1.553343"/>
  </joint>
  <joint name="joint5" type="revolute">
    <origin xyz="0.07466 0 0" rpy="-1.5707963 1.5707963 0"/>
    <parent link="link4"/>
    <child link="link5"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.553343" upper="1.553343"/>
  </joint>
  <joint name="joint6" type="revolute">
    <origin xyz="0 -0.035 0" rpy="1.5707963 0 0"/>
    <parent link="link5"/>
    <child link="link6"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9670597" upper="2.9670597"/>
  </joint>
  <joint name="flange_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="link6"/>
    <child link="flange_link"/>
  </joint>
  <joint name="gripper_base_joint" type="fixed">
    <origin xyz="0 0 0.0045" rpy="0 0 1.5707963"/>
    <parent link="flange_link"/>
    <child link="gripper_base"/>
  </joint>
  <joint name="gripper" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="gripper_base"/>
    <child link="gripper_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.1"/>
  </joint>
  <joint name="gripper_joint1" type="prismatic">
    <origin xyz="0 0 0.138" rpy="1.5707963 0 0"/>
    <parent link="gripper_base"/>
    <child link="gripper_link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.05"/>
  </joint>
  <joint name="gripper_joint2" type="prismatic">
    <origin xyz="0 0 0.138" rpy="1.5707963 0 -3.1415926"/>
    <parent link="gripper_base"/>
    <child link="gripper_link2"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.05" upper="0"/>
  </joint>
  <joint name="tcp_joint" type="fixed">
    <origin xyz="0 0 0.13025994854895165" rpy="0 0 0"/>
    <parent link="link6"/>
    <child link="tcp_link"/>
  </joint>
</robot>
